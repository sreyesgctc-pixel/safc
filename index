  <main id="main">
    <!-- HERO -->
    <section class="hero" id="top">
      <div class="wrap hero-grid">
        <div>
          <p class="kicker">Student-led. Community-driven.</p>
          <h1>Your Voice Is the <span class="accent">Movement</span></h1>
          <p class="hero-copy">Students Advocating for Change unites students nationwide to address the issues that matter most &mdash; through activism, awareness, and collective action.</p>
          <div class="hero-cta">
            <a href="#get-involved" class="btn btn-primary">Join the Movement</a>
            <a href="#issues" class="btn btn-outline">See Our Projects</a>
          </div>
        </div>

        <div class="badge-card">
          <img src="images/logo.jpg" alt="Students Advocating for Change logo. Our voice is where change begins.">
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="about" id="about" aria-labelledby="about-heading">
      <div class="wrap about-grid">
        <blockquote class="quote" style="margin:0">
          <p>Change doesn&rsquo;t wait for permission. It starts with students like you.</p>
        </blockquote>
        <div class="about-copy">
          <h2 id="about-heading" class="sr-only" style="position:absolute;left:-9999px">About Students Advocating for Change</h2>
          <p>We believe every student has the power to shape their community. Students Advocating for Change equips young people with the tools, connections, and courage to take on the issues that affect their lives &mdash; from civic engagement to educational equity to building community.</p>
          <p class="strong">Nationwide. Student-led. Community-driven.</p>
        </div>
      </div>
    </section>

    <!-- ISSUES -->
    <section class="issues" id="issues" aria-labelledby="issues-heading">
      <div class="wrap">
        <h2 class="section-title" id="issues-heading">What We&rsquo;re Fighting For</h2>

        <div class="cards">
          <article class="card">
            <div class="card-media">
              <img src="images/civic-engagement.jpg" alt="Student volunteers in matching white shirts posing together at an outdoor event" loading="lazy" onerror="this.remove()">
              <span class="chip">Civic Engagement</span>
            </div>
            <div class="card-body">
              <h3>Civic Engagement</h3>
              <p>Engaging youth to engage civically in our society as citizens. Educating, empowering, and giving youth a place at the table to express their views.</p>
            </div>
          </article>

          <article class="card">
            <div class="card-media">
              <img src="images/educational-equity.jpg" alt="Students handing out school supplies and materials" loading="lazy" onerror="this.remove()">
              <span class="chip">Education</span>
            </div>
            <div class="card-body">
              <h3>Educational Equity</h3>
              <p>Fighting for education across all levels. Our aim is to create a conscious society of youth and individuals so they can be empowered to pursue their dreams.</p>
            </div>
          </article>

          <article class="card">
            <div class="card-media">
              <img src="images/community-safety.jpg" alt="Handwritten thank-you note reading Gracias por todo lo que hacen on foil-wrapped food" loading="lazy" onerror="this.remove()">
              <span class="chip">Community</span>
            </div>
            <div class="card-body">
              <h3>Community Safety</h3>
              <p>Advocating for policies that protect and empower communities. Engaging broader communities to unite and grow together.</p>
            </div>
          </article>
        </div>

        <a href="#get-involved" class="see-all">See all Projects &rarr;</a>
      </div>
    </section>

    <!-- IMPACT -->
    <section class="impact" aria-labelledby="impact-heading">
      <div class="wrap">
        <h2 id="impact-heading">Our Impact</h2>
        <ul class="stats">
          <li><div class="stat-num"><span data-count="2000">2,000</span>+</div><div class="stat-label">Students reached</div></li>
          <li><div class="stat-num"><span data-count="10">10</span>+</div><div class="stat-label">Successful projects</div></li>
          <li><div class="stat-num"><span data-count="2">2</span></div><div class="stat-label">States impacted</div></li>
          <li><div class="stat-num"><span data-count="3">3</span></div><div class="stat-label">Years of action</div></li>
        </ul>
      </div>
    </section>

    <!-- DONATE -->
    <section class="donate" id="donate" aria-labelledby="donate-heading">
      <div class="wrap donate-inner">
        <div>
          <h2 id="donate-heading">Power the next campaign.</h2>
          <p>Your donation goes directly to student-led organizing and activism.</p>
        </div>
        <!-- Replace # with your donation link (PayPal, Venmo, Givebutter, etc.) -->
        <a href="#" class="btn btn-white">Donate Now &rarr;</a>
      </div>
    </section>

    <!-- GET INVOLVED -->
    <section class="cta" id="get-involved" aria-labelledby="cta-heading">
      <div class="wrap cta-grid">
        <div class="cta-photo">
          <img src="images/festival.jpg" alt="Five students holding a Nuestra Tierra Festival banner in front of an outdoor stage at night" loading="lazy" onerror="this.remove()">
        </div>
        <div>
          <h2 id="cta-heading">Ready to Make a Difference?</h2>
          <p>Whether you&rsquo;re a first-time activist or a seasoned organizer, there&rsquo;s a place for you here. Propose a project, start a chapter, or just show up &mdash; every action matters.</p>
          <div class="hero-cta">
            <a href="#contact" class="btn btn-primary">Get Involved Today</a>
            <a href="#about" class="btn btn-outline">Learn More About Us</a>
          </div>
