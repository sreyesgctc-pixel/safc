<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Students Advocating for Change | Your Voice Is the Movement</title>
  <meta name="description" content="Students Advocating for Change unites students nationwide to address the issues that matter most through activism, awareness, and collective action.">
  <meta property="og:title" content="Students Advocating for Change">
  <meta property="og:description" content="Student-led. Community-driven. Join the movement.">
  <meta property="og:type" content="website">
  <meta name="theme-color" content="#C4622D">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chango&family=Nunito+Sans:wght@400;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #FAF6EE;
      --cream-deep: #F3EBDA;
      --butter: #F6E7B4;
      --ink: #231C19;
      --ink-soft: #5A4F49;
      --clay: #C4622D;
      --clay-dark: #A44E20;
      --gold: #CFA73A;
      --line: #E6DCC8;
      --radius: 18px;
      --serif: "Playfair Display", Georgia, "Times New Roman", serif;
      --sans: "Nunito Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
      --wrap: 1180px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 90px; }
    body {
      margin: 0;
      font-family: var(--sans);
      font-size: 1.0625rem;
      line-height: 1.65;
      color: var(--ink);
      background: var(--cream);
      -webkit-font-smoothing: antialiased;
    }
    img, svg { display: block; max-width: 100%; }
    a { color: inherit; text-decoration: none; }
    h1, h2, h3 { font-family: var(--serif); line-height: 1.12; margin: 0; letter-spacing: -0.01em; }
    p { margin: 0; }
    .wrap { width: min(var(--wrap), 100% - 3rem); margin-inline: auto; }

    :focus-visible { outline: 3px solid var(--clay); outline-offset: 3px; border-radius: 6px; }
    .skip { position: absolute; left: -999px; top: 0; background: var(--ink); color: #fff; padding: .75rem 1rem; z-index: 200; }
    .skip:focus { left: 0; }

    /* ---------- Buttons ---------- */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
      font: 800 .95rem/1 var(--sans);
      padding: 1rem 1.7rem;
      border-radius: 999px;
      border: 2px solid transparent;
      cursor: pointer;
      transition: background-color .2s, color .2s, border-color .2s, transform .2s;
    }
    .btn:active { transform: translateY(1px); }
    .btn-primary { background: var(--clay); color: #fff; box-shadow: 0 8px 18px -8px rgba(164,78,32,.7); }
    .btn-primary:hover { background: var(--clay-dark); }
    .btn-outline { border-color: var(--ink-soft); color: var(--ink); background: transparent; }
    .btn-outline:hover { background: var(--ink); color: #fff; border-color: var(--ink); }
    .btn-gold { background: var(--gold); color: var(--ink); padding: .7rem 1.3rem; font-size: .88rem; }
    .btn-gold:hover { background: #BF9730; }
    .btn-donate { background: var(--clay); color: #fff; padding: .7rem 1.3rem; font-size: .88rem; }
    .btn-donate:hover { background: var(--clay-dark); }
    .btn-white { background: #fff; color: var(--clay-dark); box-shadow: 0 10px 24px -10px rgba(0,0,0,.45); }
    .btn-white:hover { background: var(--cream); }

    /* ---------- Header ---------- */
    .site-header {
      position: sticky; top: 0; z-index: 100;
      background: rgba(250,246,238,.94);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
    }
    .nav { display: flex; align-items: center; justify-content: space-between; min-height: 76px; gap: 1.5rem; }
    .brand { display: flex; align-items: center; gap: .6rem; }
    .brand-text { font-family: var(--serif); font-weight: 700; font-size: .9rem; line-height: 1.1; color: var(--ink); }
    .nav-links { display: flex; align-items: center; gap: 2rem; list-style: none; margin: 0; padding: 0; }
    .nav-links a:not(.btn) { font-weight: 600; font-size: .95rem; color: var(--ink-soft); padding: .25rem 0; border-bottom: 2px solid transparent; transition: color .2s, border-color .2s; }
    .nav-links a:not(.btn):hover { color: var(--ink); border-color: var(--clay); }
    .nav-actions { display: flex; align-items: center; gap: .6rem; }
    .menu-toggle { display: none; background: none; border: 0; padding: .5rem; cursor: pointer; color: var(--ink); }

    /* ---------- Hero ---------- */
    .hero { position: relative; overflow: hidden; padding: clamp(3.5rem, 8vw, 7rem) 0 clamp(4rem, 8vw, 7rem); isolation: isolate; }
    .hero::before {
      content: ""; position: absolute; inset: 0; z-index: -2;
      background: url("images/hero-bg.jpg") center/cover no-repeat, var(--cream-deep);
    }
    .hero::after {
      content: ""; position: absolute; inset: 0; z-index: -1;
      background: linear-gradient(100deg, rgba(250,246,238,.97) 25%, rgba(250,246,238,.86) 100%);
    }
    .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 3rem; align-items: center; }
    .kicker { font-weight: 800; font-size: .9rem; color: var(--clay-dark); margin-bottom: 1.1rem; }
    .hero h1 { font-size: clamp(3rem, 7.5vw, 5.8rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.02; }
    .hero h1 .accent { color: var(--clay); display: block; }
    .hero-copy { margin-top: 1.75rem; max-width: 34rem; font-size: 1.15rem; color: var(--ink-soft); }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.25rem; }

    .badge-card {
      justify-self: center;
      width: min(100%, 400px);
      aspect-ratio: 1;
      background: var(--butter);
      border-radius: 42% 58% 55% 45% / 48% 44% 56% 52%;
      display: grid; place-items: center; align-content: center; gap: .4rem;
      padding: 2rem;
      box-shadow: 0 30px 60px -30px rgba(120,70,20,.5);
      text-align: center;
    }
    .logo-img { width: 40px; height: 40px; object-fit: contain; border-radius: 6px; background: var(--cream-deep); }
    .site-footer .logo-img { background: transparent; }
    .badge-card img { width: 100%; height: 100%; object-fit: contain; border-radius: inherit; }
    .badge-card .abbr { font-family: "Chango", var(--serif); font-size: 2rem; color: var(--clay); letter-spacing: .04em; line-height: 1; }
    .badge-card svg { width: 62%; height: auto; }
    .badge-card .tag { font-family: "Chango", var(--serif); font-size: 1rem; line-height: 1.25; color: var(--clay); max-width: 14rem; }

    .fist-fab {
      position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 90;
      width: 56px; height: 56px; border-radius: 50%;
      background: var(--clay); color: #fff; border: 0; cursor: pointer;
      display: grid; place-items: center;
      box-shadow: 0 12px 24px -8px rgba(164,78,32,.8);
      opacity: 0; pointer-events: none; transform: translateY(10px);
      transition: opacity .25s, transform .25s, background-color .2s;
    }
    .fist-fab.show { opacity: 1; pointer-events: auto; transform: none; }
    .fist-fab:hover { background: var(--clay-dark); }

    /* ---------- About ---------- */
    .about { padding: clamp(4rem, 8vw, 7rem) 0 clamp(2rem, 4vw, 3rem); }
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
    .quote {
      position: relative;
      background: linear-gradient(135deg, #FBF3E1, #F6EBD2);
      border-left: 6px solid var(--clay);
      border-radius: var(--radius);
      padding: 3.6rem 2.4rem 2.4rem;
    }
    .quote::before {
      content: "\201D"; position: absolute; top: .4rem; left: 1.7rem;
      font-family: var(--serif); font-size: 5rem; line-height: 1; color: rgba(196,98,45,.3);
    }
    .quote p { font-family: var(--serif); font-weight: 700; font-size: clamp(1.5rem, 2.6vw, 2rem); line-height: 1.25; }
    .about-copy p { color: var(--ink-soft); font-size: 1.1rem; }
    .about-copy .strong { margin-top: 1.5rem; font-family: var(--serif); font-weight: 700; font-size: 1.15rem; color: var(--ink); }

    /* ---------- Issues ---------- */
    .issues { padding: clamp(3rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 6.5rem); }
    .section-title { font-size: clamp(2.2rem, 4.5vw, 3.2rem); font-weight: 800; }
    .section-title::after { content: ""; display: block; width: 56px; height: 4px; border-radius: 2px; background: var(--clay); margin-top: 1rem; }
    .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 3rem; align-items: start; }
    .card { background: #fff; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); box-shadow: 0 18px 36px -24px rgba(60,40,20,.45); }
    .card:nth-child(2) { margin-top: 1.5rem; }
    .card-media { position: relative; aspect-ratio: 16/11; background: linear-gradient(135deg, #E9D6B4, #D9B98C); overflow: hidden; }
    .card-media img { width: 100%; height: 100%; object-fit: cover; }
    .chip { position: absolute; top: .9rem; left: .9rem; background: var(--clay); color: #fff; font-weight: 800; font-size: .75rem; padding: .35rem .8rem; border-radius: 999px; }
    .card-body { padding: 1.6rem 1.6rem 1.9rem; }
    .card h3 { font-size: 1.45rem; font-weight: 700; margin-bottom: .6rem; }
    .card p { color: var(--ink-soft); font-size: .98rem; }
    .see-all { display: block; width: fit-content; margin: 3rem auto 0; font-weight: 800; color: var(--clay-dark); border-bottom: 2px solid var(--clay); padding-bottom: .15rem; }
    .see-all:hover { color: var(--ink); }

    /* ---------- Impact ---------- */
    .impact { background: var(--ink); color: #fff; padding: clamp(4rem, 8vw, 6rem) 0; }
    .impact h2 { text-align: center; font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 700; }
    .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; margin: 3.5rem 0 0; padding: 0; list-style: none; text-align: center; }
    .stat-num { font-family: var(--serif); font-weight: 800; font-size: clamp(2.8rem, 5vw, 4rem); color: var(--clay); line-height: 1; }
    .stat-label { margin-top: .8rem; font-weight: 700; font-size: .85rem; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.75); }

    /* ---------- Donate band ---------- */
    .donate { background: var(--clay); color: #fff; padding: clamp(3rem, 6vw, 4.5rem) 0; }
    .donate-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
    .donate h2 { font-size: clamp(2rem, 4vw, 2.9rem); font-weight: 800; }
    .donate p { margin-top: .6rem; font-size: 1.1rem; opacity: .95; }

    /* ---------- Final CTA ---------- */
    .cta { padding: clamp(4rem, 8vw, 7rem) 0; }
    .cta-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
    .cta-photo {
      aspect-ratio: 1.12; background: linear-gradient(135deg, #2A2320, #4A3A30);
      border-radius: 46% 54% 52% 48% / 58% 44% 56% 42%;
      overflow: hidden; box-shadow: 0 30px 60px -30px rgba(40,25,15,.65);
    }
    .cta-photo img { width: 100%; height: 100%; object-fit: cover; }
    .cta h2 { font-size: clamp(2.2rem, 4.5vw, 3.2rem); font-weight: 800; }
    .cta p { margin-top: 1.25rem; color: var(--ink-soft); font-size: 1.1rem; max-width: 33rem; }
    .cta .hero-cta { margin-top: 2rem; }

    /* ---------- Footer ---------- */
    .site-footer { background: var(--ink); color: rgba(255,255,255,.82); padding: 4rem 0 2rem; position: relative; }
    .site-footer::before {
      content: ""; position: absolute; top: -1px; left: 0; right: 0; height: 28px;
      background: var(--cream);
      -webkit-mask: radial-gradient(18px at 18px 0, #000 98%, transparent 100%) 0 0/36px 28px repeat-x;
              mask: radial-gradient(18px at 18px 0, #000 98%, transparent 100%) 0 0/36px 28px repeat-x;
      transform: scaleY(-1); transform-origin: center;
      display: none;
    }
    .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 3rem; }
    .footer-brand .brand-text { color: #fff; }
    .footer-brand p { margin-top: 1.25rem; max-width: 22rem; font-size: 1rem; }
    .footer-col h4 { margin: 0 0 1.1rem; font-family: var(--serif); font-weight: 600; font-size: .95rem; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.6); }
    .footer-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .7rem; }
    .footer-col a:hover { color: var(--gold); }
    .social { display: flex; gap: 1rem; margin-bottom: 1.5rem; }
    .social a { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; border: 1px solid rgba(255,255,255,.25); transition: background-color .2s, border-color .2s; }
    .social a:hover { background: var(--clay); border-color: var(--clay); }
    .contact-line { font-size: .95rem; }
    .contact-line a { color: var(--gold); border-bottom: 1px solid currentColor; }
    .legal { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,.14); font-size: .85rem; color: rgba(255,255,255,.6); }

    /* ---------- Responsive ---------- */
    @media (max-width: 980px) {
      .hero-grid, .about-grid, .cta-grid { grid-template-columns: 1fr; }
      .badge-card { width: min(100%, 340px); }
      .cards { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
      .card:nth-child(2) { margin-top: 0; }
      .stats { grid-template-columns: repeat(2, 1fr); row-gap: 3rem; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
      .footer-brand { grid-column: 1 / -1; }
      .cta-photo { order: -1; }
    }
    @media (max-width: 860px) {
      .menu-toggle { display: block; }
      .nav-links {
        position: absolute; top: 100%; left: 0; right: 0;
        flex-direction: column; align-items: stretch; gap: 0;
        background: var(--cream); border-bottom: 1px solid var(--line);
        padding: .5rem 1.5rem 1.25rem;
        display: none;
      }
      .nav-links.open { display: flex; }
      .nav-links li { border-bottom: 1px solid var(--line); }
      .nav-links a:not(.btn) { display: block; padding: .9rem 0; border: 0; }
      .nav-links li.nav-cta { border: 0; padding-top: 1rem; }
      .nav-actions { gap: .6rem; }
      .nav-links li.nav-cta .btn { width: 100%; }
    }
    @media (max-width: 520px) {
      .wrap { width: min(var(--wrap), 100% - 2rem); }
      .hero-cta .btn { width: 100%; }
      .footer-grid { grid-template-columns: 1fr; }
      .donate-inner .btn { width: 100%; }
      .brand-text { font-size: .8rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      * { transition: none !important; }
    }
  </style>
</head>
